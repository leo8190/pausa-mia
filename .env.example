# Servidor local de IA (opcional) — NUNCA commitear con valores reales
# Copiar a .env y completar solo si querés probar el motor IA localmente.

# Clave API (solo en servidor, nunca en el navegador)
OPENAI_API_KEY=

# URL compatible con OpenAI (puede ser un proxy local u otro proveedor)
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo a usar
OPENAI_MODEL=gpt-4o-mini

# Puerto del servidor local de IA
AI_SERVER_PORT=3001

# Persistencia de cuentas/sesiones del servidor local.
# SQLite se usa por defecto cuando el runtime lo soporta.
# ACCOUNT_STORE_ENGINE=json fuerza fallback portable en JSON.
ACCOUNT_DB_PATH=server/data/app.db
ACCOUNT_STORE_ENGINE=
ACCOUNT_STORE_JSON_PATH=server/data/app-store.json

# Pepper opcional para hash de token de sesión.
# Si queda vacío, el servidor genera un valor efímero por proceso.
SESSION_PEPPER=

# Voz argentina neuronal (frontend) — opcional, sólo para sobreescribir el
# valor por defecto. Sin estas variables se usa la URL pública de
# rhasspy/piper-voices en Hugging Face para es_AR-daniela-high (MIT).
# Definilas sólo si querés servir el modelo desde un CDN/host propio.
VITE_PIPER_ES_AR_VOICE_URL=
VITE_PIPER_ES_AR_VOICE_CONFIG_URL=

# Endpoint remoto opcional de voz argentina (POST /v1/tts → audio/wav).
# Vacío por defecto: el frontend no envía ningún texto. Con este valor, la UI
# muestra la alternativa remota en es-AR (opt-in: casilla desmarcada). Sin él,
# el aviso de endpoint faltante aparece sólo tras fallo o incompatibilidad
# de Piper local. Nunca hay fallback automático.
# Ejemplo local: http://127.0.0.1:8787  (ver voice-service/README.md)
VITE_ARGENTINE_TTS_ENDPOINT=

# Backend opcional para fase de cuentas (frontend -> server).
# Vacío por defecto: se usa el mismo origen del frontend (/api/...).
# Debe ser http(s), sin credenciales embebidas en la URL.
# Ejemplo: http://127.0.0.1:3001
VITE_ACCOUNT_API_URL=

# Orígenes permitidos para endpoints /api/account* y /api/connectors*.
# Lista separada por comas. Si queda vacío, se usan localhost/127.0.0.1
# en puertos 5173 y 4173 para desarrollo local.
# Si se usan credenciales (cookies), "*" se rechaza.
ACCOUNT_ALLOWED_ORIGINS=

# OAuth Google (solo backend). No usar VITE_*, ni exponer secretos al navegador.
# Habilita google_calendar y google_drive. social_networks queda no configurado.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI_CALENDAR=
GOOGLE_OAUTH_REDIRECT_URI_DRIVE=
# Clave de cifrado autenticado para tokens en reposo (AES-256-GCM).
# Usar 32 bytes en base64 (recomendado) o 64 hex.
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KID=local-key-v1
