# Servidor local de IA (opcional) — NUNCA commitear con valores reales
# Copiar a .env y completar solo si querés probar el motor IA localmente.

# Clave API (solo en servidor, nunca en el navegador)
OPENAI_API_KEY=

# URL compatible con OpenAI (puede ser un proxy local u otro proveedor)
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo a usar
OPENAI_MODEL=gpt-4o-mini

# Puerto del servidor local de IA
AI_SERVER_PORT=3001

# Voz neuronal es-AR opcional (frontend, experimental) — NUNCA commitear con valores reales
# URL pública a un modelo Piper/ONNX es_AR propio (por ejemplo es_AR-daniela-high.onnx)
# con licencia clara. Sin esta variable, el motor neuronal queda no disponible y la
# interfaz lo declara honestamente en vez de simular que funciona.
VITE_PIPER_ES_AR_VOICE_URL=
