# Puerto HTTP
PORT=8787

# Orígenes permitidos (coma-separados). Vacío = denegar CORS de orígenes cruzados
# excepto ausencia de Origin (p. ej. curl local).
ARG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Requerir header Origin (true recomendado en producción pública).
# false permite requests sin Origin para desarrollo/tests locales.
ARG_REQUIRE_ORIGIN=false

# mock | piper — mock genera WAV silencioso determinístico (tests / sin modelo)
ARG_TTS_BACKEND=mock

# Rutas al binario Piper y al modelo es_AR-daniela-high (sólo con ARG_TTS_BACKEND=piper).
# En la imagen Docker el CLI queda en PATH y el modelo en /models (sin volumen).
PIPER_BIN=piper
PIPER_MODEL_PATH=./models/es_AR-daniela-high.onnx
PIPER_CONFIG_PATH=./models/es_AR-daniela-high.onnx.json

# Límites de texto (caracteres)
ARG_MAX_TEXT_CHARS=800

# Rate limit por cliente para POST /v1/tts (ventana de 1 minuto).
ARG_TTS_RATE_LIMIT_PER_MINUTE=30
