# Ejemplo de bajo costo / autostop para Fly.io — NO es un fly.toml activo.
# Este repo no despliega. Copiá a fly.toml localmente. No gasta hasta `fly deploy`.
# ADVERTENCIA DE COSTOS: máquinas, cold starts y egress pueden generar gasto.
#
# La imagen (Dockerfile) ya instala piper-tts==1.6.0 y deja es_AR-daniela-high
# en /models. No hace falta volumen. 1GB es el mínimo razonable para Piper high
# + Node + ONNX en CPU (512 MB suele quedar corto).
#
# Requisitos previos (manuales, sólo con autorización explícita):
#   1. fly auth login
#   2. fly secrets set ARG_ALLOWED_ORIGINS=https://tu-frontend.example
#   3. Opcional: pin del modelo con [build.args] HF_REVISION = "<commit_sha>"
#
# Luego: fly launch --no-deploy && fly deploy

app = "argentine-tts-example"
primary_region = "gru"

[build]
  dockerfile = "Dockerfile"

[build.args]
  HF_REVISION = "main"

[env]
  PORT = "8787"
  ARG_TTS_BACKEND = "piper"
  ARG_MAX_TEXT_CHARS = "800"
  PIPER_BIN = "piper"
  PIPER_MODEL_PATH = "/models/es_AR-daniela-high.onnx"
  PIPER_CONFIG_PATH = "/models/es_AR-daniela-high.onnx.json"

[http_service]
  internal_port = 8787
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

[[vm]]
  size = "shared-cpu-1x"
  memory = "1gb"
  cpus = 1
